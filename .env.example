# Copy to .env (mode 600) and fill in. .env is git-ignored; this file holds placeholders only.
#   cp .env.example .env && chmod 600 .env
# Every launcher loads it with:  set -a; . ./.env; set +a
# Phase 4 (code/drafter_lora) never prints, logs, commits or uploads these values; backup_p4.py scans for them
# before every upload and refuses to push on a hit.

# Hugging Face: downloads (corpus, judge adapter, Phase 3 records) and the phase 4 backups
HF_TOKEN=
HF_PUSH_REPO=

# Weights & Biases (draftalign/wandb_log.py; ENABLE_WANDB=0 turns it off)
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=
WANDB_NAME=
ENABLE_WANDB=1

# Phase 4 names. Leave unset to use the defaults in brackets.
# P4_HF_REPO=Arushhh/phase4-drafter-lora        [HF dataset the backups go to]
# DA_WANDB_PROJECT=                              [W&B project; the drafter trainer falls back to WANDB_PROJECT]
# GITHUB_TOKEN=                                  [only on the rented box, for pushes]
